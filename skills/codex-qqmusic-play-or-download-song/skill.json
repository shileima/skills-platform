    {
      "name": "cua-router-basic",
      "install": "curl -fsSL https://s3plus.sankuai.com/aiagent-bucket/cua-resources/install-intranet.sh | bash -s -- --force"
    }
  ],
  "pack": {
    "include": [
      "SKILL.md",
      "skill.json",
      "scripts"
    ]
  },
