{
  "name": "codex-github-trending-today",
  "version": "0.0.1",
  "description": "通过 Chrome 打开 GitHub 今日 Trending 热榜，汇总前 10 条仓库（名称、Star 数、中文描述），并以 Markdown 消息发送到大象本人会话。",
  "author": "mashilei",
  "license": "MIT",
  "keywords": ["github", "trending", "daxiang", "markdown", "desktop-automation", "cua"],
  "targets": ["claude", "codex", "automan", "cursor"],
  "dependencies": [
    {
      "name": "cua-router-basic",
      "install": "curl -fsSL https://raw.githubusercontent.com/shileima/cua-router-basic/main/scripts/install-remote.sh | bash"
    }
  ],
  "modules": ["dx-send-markdown"],
  "pack": {
    "include": ["SKILL.md", "skill.json", "scripts"]
  },
  "automan": {
    "source": "user",
    "metaName": "codex-github-trending-today"
  }
}
