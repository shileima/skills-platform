        },
        "selector": { "alias": "定位闪购店铺活动页面右侧折扣活动卡片上的立即创建按钮，用于开始创建折扣活动" }
      }
    },
    {
      "unionId": "WaitPageState",
      "params": { "loadState": "LOAD", "timeout": "30000" }
    },
    {
      "unionId": "ClickElementMixed",
      "params": {
        "selfHealScroll": true,
        "selfHealProbeTimeout": "5000",
        "findTimeout": "15000",
        "selfHealScrollContainer": {
          "alias": "定位闪购折扣活动新建页面主内容滚动区域，用于自愈滚动以寻找创建折扣活动按钮"
        },
        "selector": { "alias": "定位闪购折扣活动新建页面顶部标题栏右侧的创建折扣活动主按钮，用于点击进入活动配置表单" }
      }
    },
    {
      "unionId": "ClickElementMixed",
