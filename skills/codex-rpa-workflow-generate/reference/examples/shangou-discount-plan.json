        "y": "600",
        "selector": {
          "alias": "定位闪购商家后台左侧导航菜单栏容器，用于向下滚动600像素"
        }
      }
    },
    {
      "unionId": "VerifyTextPresent",
      "params": { "text": "店铺活动" }
    },
    {
      "unionId": "ClickElementMixed",
      "params": {
        "selector": { "alias": "定位闪购商家后台左侧导航栏中的店铺活动菜单项，用于点击进入店铺活动页面" }
      }
    },
    {
      "unionId": "ClickElementMixed",
      "params": {
