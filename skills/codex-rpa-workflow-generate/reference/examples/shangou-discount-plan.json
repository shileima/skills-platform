        },
        "selector": { "alias": "定位闪购折扣活动表单中的添加商品按钮，用于打开添加商品弹框" }
      }
    },
    {
      "unionId": "ClickElementMixed",
      "params": {
        "selector": { "alias": "定位闪购添加商品弹框中商品名称筛选项，用于选择按商品名称搜索" }
