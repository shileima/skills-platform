    {
      "unionId": "ScrollToPosition",
      "params": {
        "x": "0",
        "y": "9999",
        "selector": {
          "alias": "定位闪购折扣活动表单右侧主内容滚动区域，用于向下滚动到商品列表底部"
        }
      }
    },
    {
      "unionId": "ClickElementMixed",
      "params": {
        "selector": { "alias": "定位闪购折扣活动商品列表中请设置链接或按钮，用于打开商品折扣设置弹框" }
      }
    },
    {
      "unionId": "FillText",
      "params": {
        "text": "9",
        "selector": { "alias": "定位闪购商品折扣设置弹框中的折扣输入框，用于输入9折折扣数值" }
