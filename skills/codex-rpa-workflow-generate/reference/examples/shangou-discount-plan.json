      }
    },
    {
      "unionId": "ClickElementMixed",
      "params": {
        "selector": { "alias": "定位闪购添加商品弹框搜索条件下拉列表中的苹果手机选项，用于选择苹果手机分类" }
      }
    },
    {
      "unionId": "ClickElementMixed",
      "params": {
        "selector": { "alias": "定位闪购添加商品弹框中的搜索按钮，用于执行商品搜索" }
